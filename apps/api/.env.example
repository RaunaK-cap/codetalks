PORT=4000
WEB_ORIGIN=http://localhost:3000
# How many proxies sit in front of Express: 1 locally (Next.js rewrite), 2 on Render (load balancer + Next.js)
TRUST_PROXY=1

# Better Auth: secret from `openssl rand -base64 32`; URL is the WEB origin (auth is reached through it)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# OAuth apps; each provider turns on only when both values are set
# GitHub callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon: pooled URL for the app, direct URL for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional but recommended: fine-grained token, public repositories read-only (60 -> 5000 req/hour)
GITHUB_TOKEN=

# LLM: Google Gemini through its OpenAI-compatible endpoint (aistudio.google.com → Get API key)
GOOGLE_API_KEY=
LLM_TEXT_MODEL=gemini-3.5-flash
LLM_VISION_MODEL=gemini-3.1-flash-lite
# How much the model "thinks" first: low is fastest and enough for these tasks
LLM_REASONING_EFFORT=low

# Fish Audio Agents (agent must be published, max duration 360s)
FISH_API_KEY=
FISH_AGENT_ID=

# Abuse budget
CALLS_PER_USER_PER_DAY=3
CALL_MINUTES_PER_DAY=60
