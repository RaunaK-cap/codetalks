{
  "name": "api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
    "check-types": "tsc --noEmit",
    "db:generate": "bun run --cwd ../../packages/db db:generate",
    "db:migrate": "bun run --cwd ../../packages/db db:migrate",
    "db:deploy": "bun run --cwd ../../packages/db db:deploy"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "better-auth": "1.7.28",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "multer": "^2.5.0",
    "openai": "^7.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "typescript": "7.0.2"
  }
}
